# Sproutly Environment Variables Configuration
# Copy this file to .env:
# cp .env.example .env

# Server Configuration
PORT=3001
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Hugging Face Inference Providers Configuration (SERVER-SIDE ONLY)
# CRITICAL: Keep your HF token on the server. Do NOT prefix with VITE_
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=your_hugging_face_token_here

# Hugging Face Inference Providers API Router Endpoint
HF_API_BASE=https://router.huggingface.co/v1

# Open-Weight Models (Vision-Capable & Text-Instruct)
# Models supported on HF Inference Providers:
HF_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
HF_TEXT_MODEL=meta-llama/Llama-3.3-70B-Instruct

# AI Request Timeout (milliseconds)
AI_TIMEOUT_MS=25000

# Optional Pl@ntNet API Key for automated species identification (SERVER-SIDE ONLY)
# Sign up and get free key at https://my.plantnet.org
# Plant Doctor and Garden Coach remain 100% functional without this key.
PLANTNET_API_KEY=

# Weather Service (Open-Meteo)
# Open-Meteo does not require an API key for standard non-commercial usage.
# Weather context is automatically fetched using user-confirmed region or geolocation.

# Opt-in Real AI Inference Smoke Tests (optional for CI/local smoke testing)
RUN_SMOKE_TESTS=false

# Frontend (optional overrides; by default Vite proxies /api to http://localhost:3001)
# VITE_API_BASE_URL=/api
